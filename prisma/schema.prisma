generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  email                 String                  @unique
  name                  String?
  image                 String?
  emailVerified         DateTime?
  role                  UserRole                @default(VIEWER)
  preferredFramework    String?
  threatsRetentionDays  Int?                    @default(90)
  alertsRetentionDays   Int?                    @default(60)
  logsRetentionDays     Int?                    @default(30)
  exportBeforeDelete    Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  lastLoginAt           DateTime?
  textbookPurchaser     Boolean                 @default(false)
  hasAcceptedTerms      Boolean                 @default(false)
  hasAcceptedWarranties Boolean                 @default(false)
  hasAcceptedOversight  Boolean                 @default(false)
  totpSecret            String?
  mfaEnabled            Boolean                 @default(false)
  webauthnCredentials   Json?
  acceptedTermsAt       DateTime?
  apiMonitors           APIMonitor[]            @relation("UserAPIMonitors")
  accounts              Account[]
  apiProjects           ApiProject[]            @relation("ApiProjectOwner")
  auditLogs             AuditLog[]
  auditReports          AuditReport[]
  betaUsers             BetaUser[]              @relation("BetaUsers")
  chatbotConversations  ChatbotConversation[]
  consultingClients     ConsultingClient[]
  consultingJobs        ConsultingJob[]
  creditBalance         CreditBalance?
  creditTransactions    CreditTransaction[]
  dataExports           DataExport[]
  deploymentApprovals   DeploymentApproval[]    @relation("DeploymentApprover")
  deploymentRequests    DeploymentApproval[]    @relation("DeploymentRequester")
  quotes                EnterpriseQuote[]       @relation("UserQuotes")
  flywheelInsights      FlywheelInsight[]       @relation("UserInsights")
  honeypots             Honeypot[]              @relation("HoneypotOwner")
  testResults           HoneypotTestResult[]
  userNotifications     Notification[]
  notifications         NotificationPreference?
  organizationsOwned    Organization[]          @relation("OrganizationOwner")
  organizations         OrganizationMember[]
  repositories          Repository[]            @relation("RepositoryOwner")
  scanSchedules         ScanSchedule[]
  secrets               Secret[]                @relation("UserSecrets")
  sessions              Session[]
  subscriptions         Subscription[]
  assignedTickets       SupportTicket[]         @relation("AssignedTickets")
  supportTickets        SupportTicket[]
  teamsCreated          Team[]                  @relation("TeamCreatedBy")
  sentInvitations       TeamInvitation[]
  teams                 TeamMember[]
  ticketMessages        TicketMessage[]
  apiKeys               UserApiKey[]
  feedbacks             UserFeedback[]
  grantedProjectAccess  TeamProjectAccess[]     @relation("GrantedProjectAccess")
}

model UserApiKey {
  id           String    @id @default(cuid())
  userId       String
  type         String
  label        String
  encryptedKey String
  iv           String
  authTag      String
  salt         String
  maskedKey    String
  isActive     Boolean   @default(true)
  lastUsed     DateTime? @map("lastUsedAt")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

model Team {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  organizationId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdById    String
  apiMonitors    APIMonitor[]        @relation("TeamAPIMonitors")
  apiProjects    ApiProject[]
  honeypots      Honeypot[]
  repositories   Repository[]
  secrets        Secret[]            @relation("TeamSecrets")
  createdBy      User                @relation("TeamCreatedBy", fields: [createdById], references: [id])
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  invitations    TeamInvitation[]
  members        TeamMember[]
  projectAccess  TeamProjectAccess[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(DEVELOPER)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

model TeamInvitation {
  id          String           @id @default(cuid())
  teamId      String
  email       String
  role        TeamRole         @default(DEVELOPER)
  invitedById String
  invitedAt   DateTime         @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedBy   User             @relation(fields: [invitedById], references: [id])
  team        Team             @relation(fields: [teamId], references: [id])

  @@unique([teamId, email])
}

model Organization {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ownerId            String
  apiProjects        ApiProject[]
  creditBalance      CreditBalance?
  creditTransactions CreditTransaction[]
  honeypots          Honeypot[]
  owner              User                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members            OrganizationMember[]
  repositories       Repository[]
  subscriptions      Subscription[]
  teams              Team[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

model ApiProject {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  description        String?
  framework          String?
  language           String?
  specification      Json?
  metadata           Json?
  rawResponse        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String
  teamId             String?
  organizationId     String?
  repositoryId       String?             @unique
  surveillanceApiKey String?             @unique
  surveillanceKeyId  String?             @unique
  webhookSecret      String?
  createdBy          User                @relation("ApiProjectOwner", fields: [createdById], references: [id])
  organization       Organization?       @relation(fields: [organizationId], references: [id])
  repository         Repository?         @relation("ProjectRepository", fields: [repositoryId], references: [id])
  team               Team?               @relation(fields: [teamId], references: [id])
  auditLogs          AuditLog[]
  blockedIps         BlockedIp[]
  clAuditTrails      ClAuditTrail[]
  credentialAliases  CredentialAlias[]
  creditTransactions CreditTransaction[]
  documentationNodes DocumentationNode[]
  flywheelInsights   FlywheelInsight[]
  honeypots          Honeypot[]
  liveThreatEvents   LiveThreatEvent[]
  threatEvents       ThreatEvent[]
  webhookDeliveries  WebhookDelivery[]
  teamAccess         TeamProjectAccess[]
}


model OperatorKey {
  id           String   @id @default(cuid())
  operatorId   String   @unique
  publicKeyPem String
  registeredAt DateTime @default(now())
}

model Repository {
  id             String             @id @default(cuid())
  provider       RepositoryProvider @default(GITHUB)
  externalId     String             @unique
  name           String
  ownerLogin     String
  installationId String?
  defaultBranch  String             @default("main")
  status         RepositoryStatus   @default(PENDING)
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  ownerId        String
  teamId         String?
  organizationId String?
  apiProject     ApiProject?        @relation("ProjectRepository")
  honeypots      Honeypot[]
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  owner          User               @relation("RepositoryOwner", fields: [ownerId], references: [id])
  team           Team?              @relation(fields: [teamId], references: [id])
  syncStates     SyncState[]
}

model Honeypot {
  id                  String                @id @default(cuid())
  name                String
  slug                String                @unique
  status              HoneypotStatus        @default(INACTIVE)
  deploymentUrl       String?
  vercelProjectName   String?
  vercelProjectId     String?
  tier                SubscriptionPlan
  config              Json?
  suspendedReason     String?
  suspendedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  ownerId             String
  teamId              String?
  organizationId      String?
  apiProjectId        String?
  repositoryId        String?
  consultingClientId  String?
  anomalyTrainingData AnomalyTrainingData[]
  apiProject          ApiProject?           @relation(fields: [apiProjectId], references: [id])
  consultingClient    ConsultingClient?     @relation(fields: [consultingClientId], references: [id])
  organization        Organization?         @relation(fields: [organizationId], references: [id])
  owner               User                  @relation("HoneypotOwner", fields: [ownerId], references: [id])
  repository          Repository?           @relation(fields: [repositoryId], references: [id])
  team                Team?                 @relation(fields: [teamId], references: [id])
  alerts              HoneypotAlert[]
  testResults         HoneypotTestResult[]
  traffic             HoneypotTraffic[]
  incidents           Incident[]
  threatEvents        ThreatEvent[]

  @@index([consultingClientId])
}

model HoneypotTestResult {
  id          String   @id @default(cuid())
  honeypotId  String
  userId      String
  attacksSent Int      @default(0)
  results     Json
  createdAt   DateTime @default(now())
  honeypot    Honeypot @relation(fields: [honeypotId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([honeypotId])
  @@index([userId])
  @@index([createdAt])
}

model HoneypotTraffic {
  id              String   @id @default(cuid())
  honeypotId      String
  timestamp       DateTime @default(now())
  ip              String
  method          String
  path            String
  userAgent       String?
  headers         Json?
  body            Json?
  statusCode      Int?
  threatsDetected Int      @default(0)
  threatDetails   Json?
  honeypot        Honeypot @relation(fields: [honeypotId], references: [id], onDelete: Cascade)

  @@index([honeypotId, timestamp])
  @@index([ip])
}

model HoneypotAlert {
  id             String         @id @default(cuid())
  honeypotId     String
  severity       ThreatSeverity @default(MEDIUM)
  type           String
  description    String
  threats        Json
  recommendation String
  ip             String
  path           String
  timestamp      DateTime       @default(now())
  autoBlocked    Boolean        @default(false)
  resolved       Boolean        @default(false)
  resolvedAt     DateTime?
  resolution     String?
  honeypot       Honeypot       @relation(fields: [honeypotId], references: [id], onDelete: Cascade)

  @@index([honeypotId, resolved])
  @@index([severity])
  @@index([timestamp])
}

model ThreatEvent {
  id              String         @id @default(cuid())
  honeypotId      String
  apiProjectId    String?
  sourceIp        String
  userAgent       String?
  payload         Json?
  detectedAt      DateTime       @default(now())
  severity        ThreatSeverity @default(MEDIUM)
  tags            String[]       @default([])
  isFalsePositive Boolean        @default(false)
  apiProject      ApiProject?    @relation(fields: [apiProjectId], references: [id])
  honeypot        Honeypot       @relation(fields: [honeypotId], references: [id])
}

model LiveThreatEvent {
  id                       String         @id @default(cuid())
  eventType                String
  timestamp                DateTime       @default(now())
  ip                       String
  userAgent                String?
  requestPath              String?
  statusCode               Int?
  method                   String?
  headers                  Json?
  body                     Json?
  severity                 ThreatSeverity @default(MEDIUM)
  metadata                 Json?
  projectId                String
  createdAt                DateTime       @default(now())
  actionTaken              String?
  appId                    String?
  authPhase                String?
  clMode                   String?
  environment              String?
  responseLatencyMs        Int?
  sessionActiveAfterAction Boolean?
  sessionId                String?
  userId                   String?
  signature                String?
  previousSignature        String?
  project                  ApiProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([timestamp])
  @@index([eventType])
  @@index([severity])
  @@index([ip])
  @@index([authPhase])
  @@index([actionTaken])
}

model AnomalyTrainingData {
  id          String         @id @default(cuid())
  honeypotId  String
  sourceIp    String
  anomalyType String
  confidence  Float
  severity    ThreatSeverity
  features    Json
  detectedAt  DateTime       @default(now())
  validated   Boolean?
  validatedAt DateTime?
  validatedBy String?
  honeypot    Honeypot       @relation(fields: [honeypotId], references: [id])
}

model FlywheelInsight {
  id           String      @id @default(cuid())
  apiProjectId String?
  type         InsightType @default(VULNERABILITY_TREND)
  summary      String
  details      Json?
  generatedAt  DateTime    @default(now())
  modelVersion String?
  confidence   Float?
  ownerId      String?
  apiProject   ApiProject? @relation(fields: [apiProjectId], references: [id])
  owner        User?       @relation("UserInsights", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([apiProjectId])
}

model DocumentationNode {
  id           String     @id @default(cuid())
  apiProjectId String
  title        String
  content      Json
  locale       String     @default("en")
  version      String     @default("latest")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  apiProject   ApiProject @relation(fields: [apiProjectId], references: [id])
}

model CreditBalance {
  id             String              @id @default(cuid())
  userId         String?             @unique
  organizationId String?             @unique
  available      Int                 @default(0)
  consumed       Int                 @default(0)
  lastNotifiedAt DateTime?
  updatedAt      DateTime            @updatedAt
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])
  transactions   CreditTransaction[]
}

model CreditTransaction {
  id             String                @id @default(cuid())
  userId         String?
  apiProjectId   String?
  balanceId      String?
  amount         Int
  type           CreditTransactionType
  description    String?
  referenceId    String?
  referenceType  String?
  reason         String?
  metadata       Json?
  createdAt      DateTime              @default(now())
  organizationId String?
  apiProject     ApiProject?           @relation(fields: [apiProjectId], references: [id])
  balance        CreditBalance?        @relation(fields: [balanceId], references: [id])
  organization   Organization?         @relation(fields: [organizationId], references: [id])
  user           User?                 @relation(fields: [userId], references: [id])

  // Exactly one of userId/organizationId must be set — enforced at the DB
  // level via a check constraint added in a raw-SQL migration (Prisma
  // doesn't support CHECK constraints declaratively).
  @@index([userId])
  @@index([organizationId])
}

model Subscription {
  id                String             @id @default(cuid())
  plan              SubscriptionPlan
  status            SubscriptionStatus @default(TRIALING)
  provider          String
  providerReference String             @unique
  seats             Int                @default(1)
  renewsAt          DateTime?
  canceledAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userId            String?
  organizationId    String?
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
}

model SyncState {
  id           String     @id @default(cuid())
  repositoryId String
  lastSyncedAt DateTime?
  lastRevision String?
  state        Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  repository   Repository @relation(fields: [repositoryId], references: [id])
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?
  apiProjectId String?
  action       String
  resource     String
  resourceId   String?
  level        LogLevel    @default(INFO)
  message      String
  details      Json?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime    @default(now())
  createdAt    DateTime    @default(now())
  apiProject   ApiProject? @relation(fields: [apiProjectId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  creditAlertsEnabled   Boolean  @default(true)
  securityAlertsEnabled Boolean  @default(true)
  marketingOptIn        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  oauth_token_secret       String?
  oauth_token              String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @id
  expires    DateTime

  @@unique([identifier, token])
}

model BetaUser {
  id            String         @id @default(cuid())
  userId        String
  email         String
  role          BetaUserRole   @default(TESTER)
  status        BetaUserStatus @default(INVITED)
  invitedAt     DateTime       @default(now())
  activatedAt   DateTime?
  completedAt   DateTime?
  testScenarios String[]       @default([])
  feedbackCount Int            @default(0)
  metadata      Json?
  feedback      BetaFeedback[]
  user          User           @relation("BetaUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model TestScenario {
  id              String               @id @default(cuid())
  name            String
  description     String
  category        TestScenarioCategory
  priority        TestScenarioPriority
  steps           String[]
  expectedOutcome String
  status          TestScenarioStatus   @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  feedback        BetaFeedback[]

  @@index([category])
  @@index([priority])
  @@index([status])
}

model BetaFeedback {
  id               String           @id @default(cuid())
  betaUserId       String
  scenarioId       String?
  type             FeedbackType
  severity         FeedbackSeverity
  title            String
  description      String
  steps            String[]         @default([])
  expectedBehavior String?
  actualBehavior   String?
  screenshots      String[]         @default([])
  status           FeedbackStatus   @default(NEW)
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?
  metadata         Json?
  betaUser         BetaUser         @relation(fields: [betaUserId], references: [id], onDelete: Cascade)
  scenario         TestScenario?    @relation(fields: [scenarioId], references: [id])

  @@index([betaUserId])
  @@index([scenarioId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model APIMonitor {
  id                   String            @id @default(cuid())
  userId               String
  teamId               String?
  name                 String
  endpoint             String
  method               String            @default("GET")
  headers              Json              @default("{}")
  body                 String?
  expectedStatusCode   Int               @default(200)
  expectedResponseTime Int               @default(5000)
  frequency            MonitorFrequency  @default(FIVE_MINUTES)
  status               MonitorStatus     @default(ACTIVE)
  alertEmail           String?
  lastCheckedAt        DateTime          @default(now())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  team                 Team?             @relation("TeamAPIMonitors", fields: [teamId], references: [id], onDelete: Cascade)
  user                 User              @relation("UserAPIMonitors", fields: [userId], references: [id], onDelete: Cascade)
  checks               MonitorCheck[]
  incidents            MonitorIncident[]

  @@index([userId])
  @@index([teamId])
  @@index([status])
  @@index([lastCheckedAt])
}

model MonitorCheck {
  id           String     @id @default(cuid())
  monitorId    String
  statusCode   Int
  responseTime Int
  success      Boolean
  error        String?
  checkedAt    DateTime   @default(now())
  monitor      APIMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([checkedAt])
  @@index([success])
}

model MonitorIncident {
  id             String           @id @default(cuid())
  monitorId      String
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  message        String
  detectedAt     DateTime         @default(now())
  lastOccurredAt DateTime         @default(now())
  resolvedAt     DateTime?
  monitor        APIMonitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
}

model Secret {
  id                   String              @id @default(cuid())
  userId               String
  teamId               String?
  name                 String
  type                 SecretType
  value                String
  status               SecretStatus        @default(ACTIVE)
  lastRotatedAt        DateTime            @default(now())
  nextRotationAt       DateTime?
  rotationIntervalDays Int                 @default(90)
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  team                 Team?               @relation("TeamSecrets", fields: [teamId], references: [id], onDelete: Cascade)
  user                 User                @relation("UserSecrets", fields: [userId], references: [id], onDelete: Cascade)
  rotationLogs         SecretRotationLog[]

  @@index([userId])
  @@index([teamId])
  @@index([status])
  @@index([nextRotationAt])
}

model SecretRotationLog {
  id            String           @id @default(cuid())
  secretId      String
  strategy      RotationStrategy
  previousValue String
  newValue      String
  rotatedAt     DateTime         @default(now())
  expiresAt     DateTime?
  secret        Secret           @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@index([secretId])
  @@index([rotatedAt])
}

model EnterpriseQuote {
  id                        String      @id @default(cuid())
  userId                    String?
  companyName               String
  contactName               String
  contactEmail              String
  teamSize                  Int
  expectedAPIs              Int
  expectedEventsPerMonth    Int
  requiresSupport           Boolean     @default(false)
  requiresSLA               Boolean     @default(false)
  requiresCustomIntegration Boolean     @default(false)
  additionalNotes           String?
  breakdown                 Json
  status                    QuoteStatus @default(PENDING)
  validUntil                DateTime
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  user                      User?       @relation("UserQuotes", fields: [userId], references: [id])

  @@index([userId])
  @@index([contactEmail])
  @@index([status])
  @@index([createdAt])
}

model HelpArticle {
  id         String          @id @default(cuid())
  title      String
  slug       String          @unique
  content    String
  category   ArticleCategory
  audience   ArticleAudience @default(ALL)
  tags       String[]
  published  Boolean         @default(true)
  viewCount  Int             @default(0)
  helpful    Int             @default(0)
  notHelpful Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([category])
  @@index([audience])
  @@index([published])
  @@index([slug])
}

model HelpFAQ {
  id       String          @id @default(cuid())
  question String
  answer   String
  category ArticleCategory
  order    Int             @default(0)

  @@index([category])
  @@index([order])
}

model UserConsent {
  id          String   @id @default(cuid())
  userId      String
  necessary   Boolean  @default(true)
  analytics   Boolean  @default(false)
  marketing   Boolean  @default(false)
  preferences Boolean  @default(false)
  ipAddress   String?
  userAgent   String?
  consentedAt DateTime @default(now())

  @@index([userId])
  @@index([consentedAt])
}

model DataRequest {
  id          String          @id @default(cuid())
  userId      String
  type        DataRequestType
