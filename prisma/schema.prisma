  windowStart     DateTime
  windowEnd       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, aliasOrIpKey, periodKey])
  @@index([projectId])
  @@index([periodKey])
  @@index([windowStart])
}

