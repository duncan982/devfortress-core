generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  name                 String?
  image                String?
  emailVerified        DateTime?
  role                 UserRole                @default(VIEWER)
  preferredFramework   String?
  threatsRetentionDays Int?                    @default(90)
  alertsRetentionDays  Int?                    @default(60)
  logsRetentionDays    Int?                    @default(30)
  exportBeforeDelete   Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  lastLoginAt          DateTime?
  textbookPurchaser    Boolean                 @default(false)
  hasAcceptedTerms     Boolean                 @default(false)
  hasAcceptedWarranties Boolean                @default(false)
  hasAcceptedOversight Boolean                 @default(false)
  acceptedTermsAt      DateTime?
  apiMonitors          APIMonitor[]            @relation("UserAPIMonitors")
  accounts             Account[]
  apiProjects          ApiProject[]            @relation("ApiProjectOwner")
  auditLogs            AuditLog[]
  auditReports         AuditReport[]
  betaUsers            BetaUser[]              @relation("BetaUsers")
  chatbotConversations ChatbotConversation[]
  dataExports          DataExport[]
  deploymentApprovals  DeploymentApproval[]    @relation("DeploymentApprover")
  deploymentRequests   DeploymentApproval[]    @relation("DeploymentRequester")
  userNotifications    Notification[]
  notifications        NotificationPreference?
  organizationsOwned   Organization[]          @relation("OrganizationOwner")
  organizations        OrganizationMember[]
  repositories         Repository[]            @relation("RepositoryOwner")
  secrets              Secret[]                @relation("UserSecrets")
  sessions             Session[]
  subscriptions        Subscription[]
  assignedTickets      SupportTicket[]         @relation("AssignedTickets")
  supportTickets       SupportTicket[]
  teamsCreated              Team[]                  @relation("TeamCreatedBy")
  sentInvitations           TeamInvitation[]
  teams                     TeamMember[]
  ticketMessages            TicketMessage[]
  apiKeys                   UserApiKey[]
  feedbacks                 UserFeedback[]
  grantedProjectAccess      TeamProjectAccess[]     @relation("GrantedProjectAccess")
}

model UserApiKey {
  id           String    @id @default(cuid())
  userId       String
  type         String
  label        String
  encryptedKey String
  iv           String
  authTag      String
  salt         String
  maskedKey    String
  isActive     Boolean   @default(true)
  lastUsed     DateTime? @map("lastUsedAt")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

model Team {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  organizationId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdById    String
  apiMonitors    APIMonitor[]        @relation("TeamAPIMonitors")
  apiProjects    ApiProject[]
  repositories   Repository[]
  secrets        Secret[]            @relation("TeamSecrets")
  createdBy      User                @relation("TeamCreatedBy", fields: [createdById], references: [id])
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  invitations    TeamInvitation[]
  members        TeamMember[]
  projectAccess  TeamProjectAccess[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(DEVELOPER)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

model TeamInvitation {
  id          String           @id @default(cuid())
  teamId      String
  email       String
  role        TeamRole         @default(DEVELOPER)
  invitedById String
  invitedAt   DateTime         @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedBy   User             @relation(fields: [invitedById], references: [id])
  team        Team             @relation(fields: [teamId], references: [id])

  @@unique([teamId, email])
}

model Organization {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ownerId            String
  apiProjects        ApiProject[]
  owner              User                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members            OrganizationMember[]
  repositories       Repository[]
  subscriptions      Subscription[]
  teams              Team[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

model ApiProject {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  description        String?
  framework          String?
  language           String?
  specification      Json?
  metadata           Json?
  rawResponse        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String
  teamId             String?
  organizationId     String?
  repositoryId       String?             @unique
  surveillanceApiKey String?             @unique
  webhookSecret      String?
  createdBy          User                @relation("ApiProjectOwner", fields: [createdById], references: [id])
  organization       Organization?       @relation(fields: [organizationId], references: [id])
  repository         Repository?         @relation("ProjectRepository", fields: [repositoryId], references: [id])
  team               Team?               @relation(fields: [teamId], references: [id])
  auditLogs          AuditLog[]
  blockedIps         BlockedIp[]
  clAuditTrails      ClAuditTrail[]
  documentationNodes DocumentationNode[]
  liveThreatEvents   LiveThreatEvent[]
  teamAccess         TeamProjectAccess[]
}

model Repository {
  id             String             @id @default(cuid())
  provider       RepositoryProvider @default(GITHUB)
  externalId     String             @unique
  name           String
  ownerLogin     String
  installationId String?
  defaultBranch  String             @default("main")
  status         RepositoryStatus   @default(PENDING)
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  ownerId        String
  teamId         String?
  organizationId String?
  apiProject     ApiProject?        @relation("ProjectRepository")
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  owner          User               @relation("RepositoryOwner", fields: [ownerId], references: [id])
  team           Team?              @relation(fields: [teamId], references: [id])
  syncStates     SyncState[]
}

model LiveThreatEvent {
  id                       String         @id @default(cuid())
  eventType                String
  timestamp                DateTime       @default(now())
  ip                       String
  userAgent                String?
  requestPath              String?
  statusCode               Int?
  method                   String?
  headers                  Json?
  body                     Json?
  severity                 ThreatSeverity @default(MEDIUM)
  metadata                 Json?
  projectId                String
  createdAt                DateTime       @default(now())
  actionTaken              String?
  appId                    String?
  authPhase                String?
  clMode                   String?
  environment              String?
  responseLatencyMs        Int?
  sessionActiveAfterAction Boolean?
  sessionId                String?
  userId                   String?
  project                  ApiProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([timestamp])
  @@index([eventType])
  @@index([severity])
  @@index([ip])
  @@index([authPhase])
  @@index([actionTaken])
}

model DocumentationNode {
  id           String     @id @default(cuid())
  apiProjectId String
  title        String
  content      Json
  locale       String     @default("en")
  version      String     @default("latest")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  apiProject   ApiProject @relation(fields: [apiProjectId], references: [id])
}

model Subscription {
  id                String             @id @default(cuid())
  plan              SubscriptionPlan
  status            SubscriptionStatus @default(TRIALING)
  provider          String
  providerReference String             @unique
  seats             Int                @default(1)
  renewsAt          DateTime?
  canceledAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userId            String?
  organizationId    String?
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
}

model SyncState {
  id           String     @id @default(cuid())
  repositoryId String
  lastSyncedAt DateTime?
  lastRevision String?
  state        Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  repository   Repository @relation(fields: [repositoryId], references: [id])
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?
  apiProjectId String?
  action       String
  resource     String
  resourceId   String?
  level        LogLevel    @default(INFO)
  message      String
  details      Json?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime    @default(now())
  createdAt    DateTime    @default(now())
  apiProject   ApiProject? @relation(fields: [apiProjectId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  creditAlertsEnabled   Boolean  @default(true)
  securityAlertsEnabled Boolean  @default(true)
  marketingOptIn        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  oauth_token_secret       String?
  oauth_token              String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @id
  expires    DateTime

  @@unique([identifier, token])
}

model BetaUser {
  id            String         @id @default(cuid())
  userId        String
  email         String
  role          BetaUserRole   @default(TESTER)
  status        BetaUserStatus @default(INVITED)
  invitedAt     DateTime       @default(now())
  activatedAt   DateTime?
  completedAt   DateTime?
  testScenarios String[]       @default([])
  feedbackCount Int            @default(0)
  metadata      Json?
  feedback      BetaFeedback[]
  user          User           @relation("BetaUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model TestScenario {
  id              String               @id @default(cuid())
  name            String
  description     String
  category        TestScenarioCategory
  priority        TestScenarioPriority
  steps           String[]
  expectedOutcome String
  status          TestScenarioStatus   @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  feedback        BetaFeedback[]

  @@index([category])
  @@index([priority])
  @@index([status])
}

model BetaFeedback {
  id               String           @id @default(cuid())
  betaUserId       String
  scenarioId       String?
  type             FeedbackType
  severity         FeedbackSeverity
  title            String
  description      String
  steps            String[]         @default([])
  expectedBehavior String?
  actualBehavior   String?
  screenshots      String[]         @default([])
  status           FeedbackStatus   @default(NEW)
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?
  metadata         Json?
  betaUser         BetaUser         @relation(fields: [betaUserId], references: [id], onDelete: Cascade)
  scenario         TestScenario?    @relation(fields: [scenarioId], references: [id])

  @@index([betaUserId])
  @@index([scenarioId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model APIMonitor {
  id                   String            @id @default(cuid())
  userId               String
  teamId               String?
  name                 String
  endpoint             String
  method               String            @default("GET")
  headers              Json              @default("{}")
  body                 String?
  expectedStatusCode   Int               @default(200)
  expectedResponseTime Int               @default(5000)
  frequency            MonitorFrequency  @default(FIVE_MINUTES)
  status               MonitorStatus     @default(ACTIVE)
  alertEmail           String?
  lastCheckedAt        DateTime          @default(now())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  team                 Team?             @relation("TeamAPIMonitors", fields: [teamId], references: [id], onDelete: Cascade)
  user                 User              @relation("UserAPIMonitors", fields: [userId], references: [id], onDelete: Cascade)
  checks               MonitorCheck[]
  incidents            MonitorIncident[]

  @@index([userId])
  @@index([teamId])
  @@index([status])
  @@index([lastCheckedAt])
}

model MonitorCheck {
  id           String     @id @default(cuid())
  monitorId    String
  statusCode   Int
  responseTime Int
  success      Boolean
  error        String?
  checkedAt    DateTime   @default(now())
  monitor      APIMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([checkedAt])
  @@index([success])
}

model MonitorIncident {
  id             String           @id @default(cuid())
  monitorId      String
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  message        String
  detectedAt     DateTime         @default(now())
  lastOccurredAt DateTime         @default(now())
  resolvedAt     DateTime?
  monitor        APIMonitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
}

model Secret {
  id                   String              @id @default(cuid())
  userId               String
  teamId               String?
  name                 String
  type                 SecretType
  value                String
  status               SecretStatus        @default(ACTIVE)
  lastRotatedAt        DateTime            @default(now())
  nextRotationAt       DateTime?
  rotationIntervalDays Int                 @default(90)
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  team                 Team?               @relation("TeamSecrets", fields: [teamId], references: [id], onDelete: Cascade)
  user                 User                @relation("UserSecrets", fields: [userId], references: [id], onDelete: Cascade)
  rotationLogs         SecretRotationLog[]

  @@index([userId])
  @@index([teamId])
  @@index([status])
  @@index([nextRotationAt])
}

model SecretRotationLog {
  id            String           @id @default(cuid())
  secretId      String
  strategy      RotationStrategy
  previousValue String
  newValue      String
  rotatedAt     DateTime         @default(now())
  expiresAt     DateTime?
  secret        Secret           @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@index([secretId])
  @@index([rotatedAt])
}

model HelpArticle {
  id         String          @id @default(cuid())
  title      String
  slug       String          @unique
  content    String
  category   ArticleCategory
  audience   ArticleAudience @default(ALL)
  tags       String[]
  published  Boolean         @default(true)
  viewCount  Int             @default(0)
  helpful    Int             @default(0)
  notHelpful Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([category])
  @@index([audience])
  @@index([published])
  @@index([slug])
}

model HelpFAQ {
  id       String          @id @default(cuid())
  question String
  answer   String
  category ArticleCategory
  order    Int             @default(0)

  @@index([category])
  @@index([order])
}

model UserConsent {
  id          String   @id @default(cuid())
  userId      String
  necessary   Boolean  @default(true)
  analytics   Boolean  @default(false)
  marketing   Boolean  @default(false)
  preferences Boolean  @default(false)
  ipAddress   String?
  userAgent   String?
  consentedAt DateTime @default(now())

  @@index([userId])
  @@index([consentedAt])
}

model DataRequest {
  id          String          @id @default(cuid())
  userId      String
  type        DataRequestType
  status      RequestStatus   @default(PENDING)
  requestedAt DateTime        @default(now())
  completedAt DateTime?
  notes       String?

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
}

model UserOnboarding {
  id             String    @id @default(cuid())
  userId         String    @unique
  currentStep    Int       @default(1)
  completedSteps Json      @default("[]")
  skipped        Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([completedAt])
}

model UserMFA {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String
  enabled     Boolean  @default(false)
  backupCodes String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  accessToken      String    @unique
  refreshToken     String    @unique
  expiresAt        DateTime
  refreshExpiresAt DateTime
  ipAddress        String?
  userAgent        String?
  lastActivity     DateTime  @default(now())
  mfaVerified      Boolean   @default(false)
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken])
  @@index([expiresAt])
}

model ChatbotConversation {
  id              String                    @id @default(cuid())
  userId          String?
  sessionId       String                    @unique
  status          ChatbotConversationStatus @default(ACTIVE)
  topic           String?
  escalatedAt     DateTime?
  escalatedReason String?
  resolvedAt      DateTime?
  satisfaction    Int?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  user            User?                     @relation(fields: [userId], references: [id])
  messages        ChatbotMessage[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
}

model ChatbotMessage {
  id             String              @id @default(cuid())
  conversationId String
  role           ChatbotMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime            @default(now())
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model SupportTicket {
  id               String          @id @default(cuid())
  ticketNumber     String          @unique
  userId           String?
  assignedToId     String?
  subject          String
  description      String
  status           TicketStatus    @default(OPEN)
  priority         TicketPriority  @default(MEDIUM)
  source           TicketSource    @default(MANUAL)
  category         String?
  tags             String[]        @default([])
  externalId       String?
  externalUrl      String?
  conversationId   String?
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  responseTime     Int?
  resolutionTime   Int?
  satisfaction     Int?
  satisfactionNote String?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  assignedTo       User?           @relation("AssignedTickets", fields: [assignedToId], references: [id])
  user             User?           @relation(fields: [userId], references: [id])
  messages         TicketMessage[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([category])
  @@index([createdAt])
  @@index([ticketNumber])
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  authorId    String?
  content     String
  isInternal  Boolean       @default(false)
  isAutomated Boolean       @default(false)
  attachments String[]      @default([])
  metadata    Json?
  createdAt   DateTime      @default(now())
  author      User?         @relation(fields: [authorId], references: [id])
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt])
}

model AppSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

model AIPerformanceLog {
  id               String     @id @default(cuid())
  taskType         AITaskType
  provider         AIProvider
  inputHash        String
  outputSample     String?
  accuracy         Float?
  costUsd          Float
  latencyMs        Int
  errorOccurred    Boolean    @default(false)
  errorType        String?
  mlConfidence     Float?
  nlUsedAsFallback Boolean    @default(false)
  metadata         Json?
  createdAt        DateTime   @default(now())

  @@index([taskType])
  @@index([provider])
  @@index([createdAt])
  @@index([errorOccurred])
}

model DeploymentApproval {
  id                String                   @id @default(cuid())
  requesterId       String
  environment       DeploymentEnvironment
  status            DeploymentApprovalStatus @default(PENDING)
  branch            String
  commit            String
  changes           Json?
  deploymentDetails Json?
  requestedAt       DateTime                 @default(now())
  expiresAt         DateTime
  approvedById      String?
  approvedAt        DateTime?
  rejectedReason    String?
  deploymentUrl     String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  approvedBy        User?                    @relation("DeploymentApprover", fields: [approvedById], references: [id])
  requester         User                     @relation("DeploymentRequester", fields: [requesterId], references: [id])

  @@index([requesterId])
  @@index([status])
  @@index([environment])
  @@index([requestedAt])
  @@index([expiresAt])
}

model UserFeedback {
  id          String             @id @default(cuid())
  userId      String?
  type        UserFeedbackType
  sentiment   Int?
  category    String?
  page        String?
  title       String?
  description String?
  metadata    Json?
  votes       Int                @default(1)
  status      UserFeedbackStatus @default(NEW)
  adminNotes  String?
  resolvedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User?              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@index([sentiment])
  @@index([createdAt])
}

model DataExport {
  id              String       @id @default(cuid())
  userId          String
  status          ExportStatus @default(PENDING)
  downloadUrl     String?
  format          String       @default("json")
  includeThreats  Boolean      @default(true)
  includeAlerts   Boolean      @default(true)
  includeLogs     Boolean      @default(true)
  includeProjects Boolean      @default(true)
  startDate       DateTime?
  endDate         DateTime?
  fileSize        Int?
  requestedAt     DateTime     @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?
  errorMessage    String?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
  @@index([expiresAt])
}

model AuditReport {
  id               String            @id @default(cuid())
  userId           String
  targetUrl        String?
  status           AuditReportStatus @default(GENERATING)
  reportJson       Json?
  executiveSummary String?
  overallScore     Int?
  criticalCount    Int               @default(0)
  highCount        Int               @default(0)
  mediumCount      Int               @default(0)
  lowCount         Int               @default(0)
  pdfUrl           String?
  shareToken       String?           @unique @default(cuid())
  createdAt        DateTime          @default(now())
  completedAt      DateTime?
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([shareToken])
}

model ClAuditTrail {
  id            String     @id @default(cuid())
  projectId     String
  detectEventId String
  action        String
  clMode        String
  authPhase     String?
  ip            String?
  userId        String?
  confirmed     Boolean    @default(false)
  confirmedAt   DateTime?
  latencyMs     Int?
  success       Boolean?
  failureReason String?
  metadata      Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  project       ApiProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([detectEventId])
  @@index([createdAt])
  @@index([confirmed])
  @@index([action])
}

model BlockedIp {
  id             String     @id @default(cuid())
  projectId      String
  ip             String
  compositeScore Float?
  abuseIpDbScore Float?
  dfSignalScore  Float?
  source         String     @default("auto")
  reason         String?
  blockedAt      DateTime   @default(now())
  expiresAt      DateTime?
  unblockedAt    DateTime?
  metadata       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  project        ApiProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, ip])
  @@index([projectId])
  @@index([ip])
  @@index([blockedAt])
  @@index([expiresAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("active")
  segment        String    @default("general")
  source         String    @default("api")
  consentGiven   Boolean   @default(false)
  consentAt      DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([status])
}

model TeamProjectAccess {
  id          String     @id @default(cuid())
  teamId      String
  projectId   String
  grantedById String
  grantedAt   DateTime   @default(now())
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project     ApiProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  granter     User       @relation("GrantedProjectAccess", fields: [grantedById], references: [id])

  @@unique([teamId, projectId])
}

model License {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  productId  String   @map("product_id")
  purchaseId String   @map("purchase_id")
  licenseKey String?  @map("license_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("licenses")
}

