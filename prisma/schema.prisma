model CredentialAlias {
  id                String     @id @default(cuid())
  projectId         String
  workload          String     @default("custom")
  label             String
  aliasKeyHash      String
  state             String     @default("active")
  familyId          String?
  scope             String?
  tags              String?
  maxUses           Int?
  expiresAt         DateTime?
  usageCount        Int        @default(0)
  lastUsedAt        DateTime?
  rotatedFromId     String?
  rotatedToId       String?
  revokedAt         DateTime?
  revocationReason  String?
  bindingIpCidr     String?
  bindingRegions    String[]
  bindingTimeZone   String?
  bindingTimeStart  String?
  bindingTimeEnd    String?
  bindingWorkloadId String?
  bindingDeviceId   String?
  bindingAppBundle  String?
  bindingAgentTools String[]
  // CTXFP-P1-03 — agent execution-context baseline (workload='agent' aliases).
  // Written by the Postgres-backed create route, not by the SDK's disconnected
  // in-memory AgentCredentialManager — two distinct alias mechanisms by design.
  bindingContainerId              String?
  bindingExpectedEgressPath       String?
  bindingExpectedProcessSignature String?
  // Task-scope fencing — a per-alias declared task narrows bindingAgentTools
  // (the agent's overall static allow-list) to the subset actually needed
  // for that task. Additive, nullable/empty-default: an alias created
  // without a declared task is unaffected — see hasBindingBaseline() and
  // the task_scope_violation check in lib/alias-binding-validator.ts.
  declaredTask              String?
  declaredTaskAllowedTools  String[]
  // Operation-class verification — the class(es) of operation (read,
  // download, list, write, publish, message) this alias was issued for,
  // independent of what the target system's own authorization allows.
  // Additive, empty-default: an alias created without any recorded classes
  // is unaffected — see hasBindingBaseline() and the
  // operation_class_violation check in lib/alias-binding-validator.ts.
  permittedOperationClasses String[]
  // Model/build identity — one more component of the CTXFP-P1-03 execution-
  // context fingerprint, alongside bindingExpectedProcessSignature.
  // Captured at issuance for workload:'agent' aliases only (accepted
  // regardless, same permissive pattern as the other binding fields).
  // Opaque string — no model registry. Design note: the observed value
  // compared against this at verify time must be reported by the
  // orchestrating harness, outside the agent's own execution context — an
  // agent reporting this about itself defeats the check, the same
  // trust-boundary reasoning as bindingExpectedProcessSignature.
  bindingExpectedModelIdentifier String?
  // Named human owner — an optional, free-form identifier (user id or
  // email; not validated against the User table, so it also works for an
  // owner who isn't a DevFortress platform user) captured at creation.
  // Additive, nullable: an alias created without one is unaffected —
  // existing API clients keep working unchanged. No project-level
  // "require owner" enforcement — that's explicitly out of scope here.
  ownerIdentifier   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  project           ApiProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([state])
  @@index([familyId])
  @@index([rotatedFromId])
}

// Postgres-backed store for the multi-hop trust chain mechanism,
// replacing its previous in-memory-only Map so chains survive process restarts.
model TrustChainRecord {
  chainId         String          @id
  originServiceId String
  valid           Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  hops            TrustChainHop[]

  @@index([originServiceId])
}

model TrustChainHop {
  id            String           @id @default(cuid())
  chainId       String
  chain         TrustChainRecord @relation(fields: [chainId], references: [chainId], onDelete: Cascade)
  hopIndex      Int
  serviceId     String
  aliasId       String
  hopTimestamp  BigInt
  signature     String
  parentAliasId String?
  trust         Float
  scope         String[]
  createdAt     DateTime         @default(now())
  // Invocation-context fingerprint (additive, nullable) — mirrors
  // CredentialAlias's bindingIpCidr/bindingWorkloadId/bindingDeviceId/
  // bindingContainerId dimensions at the per-hop level for the multi-hop
  // trust chain. Null when a hop carries no fingerprint.
  fingerprintRequestIp         String?
  fingerprintGeoCountry        String?
  fingerprintWorkloadId        String?
  fingerprintDeviceFingerprint String?
  fingerprintContainerId       String?

  @@unique([chainId, hopIndex])
  @@index([chainId])
  @@index([aliasId])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("active")
  segment        String    @default("general")
  source         String    @default("api")
  consentGiven   Boolean   @default(false)
  consentAt      DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([status])
}

model EnterpriseOnboardingRecord {
  id               String   @id @default(cuid())
  orgId            String   @unique
  orgName          String
  contractSignedAt DateTime
  kickoffDate      DateTime
  targetGoLiveDate DateTime
  csmAssignment    Json
  steps            Json
  currentPhase     String
  overallProgress  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orgId])
  @@index([currentPhase])
}

