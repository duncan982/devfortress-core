model License {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  productId  String   @map("product_id")
  purchaseId String   @map("purchase_id")
  licenseKey String?  @map("license_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("licenses")
}

model TeamProjectAccess {
  id          String     @id @default(cuid())
  teamId      String
  projectId   String
  grantedById String
  grantedAt   DateTime   @default(now())
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project     ApiProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  granter     User       @relation("GrantedProjectAccess", fields: [grantedById], references: [id])

  @@unique([teamId, projectId])
}

model InvoiceCounter {
  id  String @id @default("global")
  seq Int    @default(0)
}

model EnterpriseIntake {
  id                   String    @id @default(cuid())
  companyName          String
  legalEntityName      String
  contactName          String
  contactEmail         String
  jobTitle             String
  vatNumber            String?
  estimatedEndpoints   Int?
  deploymentType       String?
  complianceFrameworks String[]
  aiAgentCount         Int?
  billingCycle         String
  preferredPayment     String
  estimatedAnnualUsd   Float
  invoiceType          String
  agreementAcceptedAt  DateTime
  acceptanceIp         String?
  message              String?
  status               String    @default("pending_contract")
  invoiceRef           String?
  invoiceSentAt        DateTime?
  paymentConfirmedAt   DateTime?
  paymentReceiptRef    String?
  provisionedUserId    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Postgres-backed rate limit buckets for auth + AI-invoking routes (TODO 115).
// One row per (route, identity) key; count resets when windowStart rolls over.
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  windowStart DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

model RedisFallback {
  key        String   @id
  value      String
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([expires_at], name: "idx_redis_fallback_expires_at")
}

model KraReport {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period    String   @unique
  liability Json
  csv       String
  createdAt DateTime @default(now())

  @@index([period], name: "idx_kra_report_period")
}

model CustomRule {
  id             String   @id @default(uuid())
  userId         String
  name           String
  description    String?
  priority       Int      @default(500)
  conditions     Json
  conditionLogic String   @default("AND")
  action         Json
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([priority])
}
