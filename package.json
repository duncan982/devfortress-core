  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@swc/core": "^1.14.0",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/license-checker": "^25.0.6",
    "@types/node": "^20",
    "@types/opossum": "^8.1.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/retry": "^0.12.5",
    "@types/speakeasy": "^2.0.10",
    "@types/testing-library__jest-dom": "^5.14.9",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.8.32",
    "bcryptjs": "^3.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.0.7",
    "husky": "^9.1.7",
    "import-in-the-middle": "^2.0.0",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsonwebtoken": "^9.0.2",
    "license-checker": "^25.0.1",
    "lighthouse": "^13.1.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "prisma": "^6.19.2",
    "require-in-the-middle": "^8.0.1",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.2.8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "winston": "^3.18.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
