{
  "name": "devfortress",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:full": "bash -c 'echo \"🚀 Starting full development environment...\" && npm run db:start && sleep 3 && echo \"🌐 Starting Next.js dev server...\" && echo \"📊 Database will be checked once server starts...\" && npm run dev'",
    "dev:stop": "bash -c 'echo \"🛑 Stopping development environment...\" && pkill -f \"next dev\" 2>/dev/null && npm run db:stop && echo \"✅ Development environment stopped\"'",
    "dev:down": "bash -c 'echo \"🛑 Shutting down development environment...\" && pkill -f \"next dev\" 2>/dev/null && npm run db:down && echo \"✅ Development environment shut down\"'",
    "build": "prisma generate && next build",
    "postbuild": "git rev-parse HEAD 2>/dev/null > .build-cache || true",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:accessibility": "jest --testPathPattern=accessibility",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit --audit-level critical || echo '⚠️ Known transitive vulnerabilities in @sentry/webpack-plugin chain - tracked for upstream fix'",
    "security:scan": "bash scripts/security-audit.sh",
    "docker:build": "docker build -t devfortress .",
    "docker:run": "docker run -p 3000:3000 devfortress",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose up -d",
    "backup": "bash scripts/backup.sh",
    "backup:compress": "bash scripts/backup.sh --compress",
    "restore": "bash scripts/restore.sh",
    "db:setup": "bash scripts/db-setup.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "db:start": "docker-compose -f docker-compose.local.yml up -d postgres",
    "db:stop": "docker-compose -f docker-compose.local.yml stop",
    "db:down": "docker-compose -f docker-compose.local.yml down",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:schema": "tsx --env-file=.env.local scripts/migrate-database-schema.ts",
    "db:migrate:production": "tsx scripts/migrate-production.ts",
    "db:migrate:standard": "tsx scripts/migration-manager.ts",
    "db:migrate:local": "npm run db:migrate:standard -- migrate",
    "db:migrate:staging": "npm run db:migrate:standard -- migrate --env staging",
    "db:migrate:prod": "npm run db:migrate:standard -- migrate --env production --create-backup --confirm-production",
    "db:migrate:dry-run": "npm run db:migrate:standard -- migrate --dry-run",
    "db:fix-production": "tsx scripts/migrate-production.ts",
    "db:fix-manually": "tsx scripts/fix-database-manually.ts",
    "db:test-connectivity": "tsx scripts/test-db-connectivity.ts",
    "validate:api-generation": "tsx --env-file=.env.local scripts/validate-api-generation.ts",
    "dev:check": "bash -c 'echo \"📊 Checking development environment...\" && if docker-compose -f docker-compose.local.yml ps postgres 2>/dev/null | grep -q \"Up\"; then echo \"✅ Database: Running\"; else echo \"❌ Database: Stopped - run: npm run db:start\"; fi && if pgrep -f \"next dev\" > /dev/null; then echo \"✅ Dev Server: Running\"; else echo \"❌ Dev Server: Stopped - run: npm run dev\"; fi && if curl -s http://localhost:3000/api/health 2>/dev/null | grep -q \"\\\"connected\\\":true\"; then echo \"✅ Database Connection: OK\"; else echo \"❌ Database Connection: Failed\"; fi'",
    "db:status": "npm run db:execute -- --sql \"SELECT version() as postgres_version, current_database() as database_name, current_user as current_user;\"",
    "db:check-status": "tsx --env-file=.env.local scripts/check-migration-status.ts",
    "db:execute": "tsx --env-file=.env.local scripts/execute-sql.ts",
    "test:devfortress": "tsx .agents/testing/vortexsecure-testing-agent.ts",
    "test:devfortress:analysis": "npm run test:devfortress -- analysis",
    "test:devfortress:info": "npm run test:devfortress -- information_gathering",
    "test:devfortress:execute": "npm run test:devfortress -- execution",
    "test:devfortress:report": "npm run test:devfortress -- reporting",
    "test:project": "tsx .agents/testing/project-testing-agent.ts",
    "test:project:analysis": "npm run test:project -- analysis",
    "test:project:info": "npm run test:project -- information_gathering",
    "test:project:execute": "npm run test:project -- execution",
    "test:project:report": "npm run test:project -- reporting",
    "test:project:validate": "tsx .agents/testing/validate-env.ts",
    "test:project:runner": "tsx .agents/testing/run-tests.ts",
    "db:studio": "prisma studio",
    "db:fix-rls": "node scripts/fix-rls-security.js",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx --env-file=.env.local prisma/seed.ts",
    "reset-test-account": "tsx --env-file=.env.local scripts/reset-test-account.ts",
    "check-onboarding": "tsx --env-file=.env.local scripts/check-onboarding-status.ts",
    "license:audit": "tsx scripts/license-audit.ts",
    "validate:deps": "tsx scripts/validate-dependencies.ts",
    "analyze:pricing": "tsx --env-file=.env.local scripts/analyze-pricing-quotas.ts",
    "ci": "npm run lint && npm run type-check && npm run test:unit && npm run validate:deps && npm run license:audit && npm run security:audit",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:coverage": "jest --coverage",
    "agents:sync": "bash scripts/sync-agents.sh --modified",
    "agents:sync:full": "bash scripts/sync-agents.sh --full",
    "agents:sync:modified": "bash scripts/sync-agents.sh --modified",
    "deploy:vercel": "tsx --env-file=.env.local scripts/deploy-vercel.ts",
    "deploy:vercel:preview": "tsx --env-file=.env.local scripts/deploy-vercel.ts --env=preview",
    "deploy:vercel:production": "tsx --env-file=.env.local scripts/deploy-vercel.ts --env=production",
    "deploy:vercel:rollback": "vercel rollback",
    "env:list": "tsx --env-file=.env.local scripts/deploy-vercel.ts --env-list",
    "env:set": "tsx --env-file=.env.local scripts/deploy-vercel.ts --env-set",
    "env:update": "tsx --env-file=.env.local scripts/deploy-vercel.ts --env-update",
    "env:delete": "tsx --env-file=.env.local scripts/deploy-vercel.ts --env-delete",
    "verify:supabase-env": "node scripts/verify-supabase-env.js",
    "setup:vercel-env": "bash scripts/setup-vercel-env.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.4.1",
    "@octokit/rest": "^22.0.1",
    "@paddle/paddle-js": "^1.6.4",
    "@prisma/client": "^6.19.2",
    "@prisma/engines": "^7.1.0",
    "@sentry/nextjs": "^10.30.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.80.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "amqplib": "^0.10.9",
    "devfortress-sdk": "^4.9.0",
    "dotenv": "^17.2.3",
    "highlight.js": "^11.11.1",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^3.8.0",
    "lightrag-js": "^1.0.4",
    "lucide-react": "^0.560.0",
    "next": "^15.5.18",
    "next-intl": "^4.12.0",
    "openai": "^6.10.0",
    "opossum": "^9.0.0",
    "paystack-sdk": "^3.5.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "retry": "^0.13.1",
    "server-only": "^0.0.1",
    "speakeasy": "^2.0.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.12"
