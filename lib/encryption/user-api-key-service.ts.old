/**
 * User API Key Service
 *
 * Provides functions to retrieve and manage user API keys for self-hosted deployments.
 *
 * @module lib/encryption/user-api-key-service
 */

import { prisma } from '@/lib/prisma';
import { decryptApiKey } from './api-key-encryption';
import { logInfo, logError, logWarn } from '@/lib/logger';

/**
 * Retrieves a user's decrypted API key for a specific provider.
 *
 * @param userId - The user's ID
 * @param provider - The API provider (e.g., 'openai', 'anthropic')
 * @returns The decrypted API key, or null if not found
 */
export async function getUserApiKey(
  userId: string,
  provider: string
): Promise<string | null> {
  try {
    const apiKey = await prisma.userApiKey.findUnique({
      where: {
        userId_provider: {
          userId,
          provider: provider.toLowerCase(),
        },
      },
    });

    if (!apiKey) {
      logInfo('User API key not found', { userId, provider });
      return null;
    }

    if (!apiKey.isValid) {
      logWarn('User API key marked as invalid', { userId, provider });
      return null;
    }

    // Decrypt and return
    const decryptedKey = decryptApiKey(apiKey.encryptedKey);

    // Update last used timestamp (non-blocking)
    prisma.userApiKey
      .update({
        where: { id: apiKey.id },
        data: { lastUsedAt: new Date() },
      })
      .catch((err: unknown) =>
        logError('Failed to update lastUsedAt', { error: err })
      );

    return decryptedKey;
  } catch (error) {
    logError('Failed to retrieve user API key', { userId, provider, error });
    return null;
  }
}

/**
 * Marks a user's API key as invalid (e.g., after authentication failure).
 *
 * @param userId - The user's ID
 * @param provider - The API provider
 */
export async function markApiKeyInvalid(
  userId: string,
  provider: string
): Promise<void> {
  try {
    await prisma.userApiKey.update({
      where: {
        userId_provider: {
          userId,
          provider: provider.toLowerCase(),
        },
      },
      data: { isValid: false },
    });

    logWarn('User API key marked as invalid', { userId, provider });
  } catch (error) {
    logError('Failed to mark API key as invalid', { userId, provider, error });
  }
}

/**
 * Checks if a user has a valid API key for a specific provider.
 *
 * @param userId - The user's ID
 * @param provider - The API provider
 * @returns true if a valid key exists
 */
export async function hasValidApiKey(
  userId: string,
  provider: string
): Promise<boolean> {
  try {
    const apiKey = await prisma.userApiKey.findUnique({
      where: {
        userId_provider: {
          userId,
          provider: provider.toLowerCase(),
        },
      },
      select: { isValid: true },
    });

    return apiKey?.isValid === true;
  } catch (error) {
    logError('Failed to check API key validity', { userId, provider, error });
    return false;
  }
}

/**
 * Gets all valid providers for a user.
 *
 * @param userId - The user's ID
 * @returns Array of provider names with valid keys
 */
export async function getUserValidProviders(userId: string): Promise<string[]> {
  try {
    const keys = await prisma.userApiKey.findMany({
      where: {
        userId,
        isValid: true,
      },
      select: { provider: true },
    });

    return keys.map((k: { provider: string }) => k.provider);
  } catch (error) {
    logError('Failed to get user valid providers', { userId, error });
    return [];
  }
}
