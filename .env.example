# DevFortress — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# See README.md → Environment Setup for detailed instructions.

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Supabase Dashboard → Settings → Database → Connection string
# Use the "Transaction" pooler URL (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the "Session" pooler URL (port 5432) for DIRECT_DATABASE_URL
DIRECT_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ── Auth secrets ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Must be >=32 chars if set at all — leave this line commented out rather
# than blank; an empty string still fails schema validation and breaks
# `next build`.
# NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3001"

# ── OpenAI (optional — used for AI-assisted features) ─────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# ── DevFortress SDK ───────────────────────────────────────────────────────────
# Get your API key from: https://devfortress.net/dashboard/credentials
DEVFORTRESS_API_KEY="vx_test_your_api_key_here"
DEVFORTRESS_APP_ID="my-app"
# Point to hosted platform or your self-hosted instance
DEVFORTRESS_ENDPOINT="https://devfortress.net/api/events/ingest"
DEVFORTRESS_WEBHOOK_SECRET=
# Platform/service-provider admin validation key — not the same as
# DEVFORTRESS_API_KEY above. See Vercel for the production value.
DF_ADMIN_API_KEY=
# ARD Hard-Gate capability-signing key (Ed25519, server-side only).
# See Vercel for the production value.
ARD_CAPABILITY_SIGNING_PRIVATE_KEY=

# Tamper-evident alias-violation audit-trail signing (HMAC-SHA256, server-side
# only). Separate, symmetric, freely-regenerable secret — not the ARD key above.
AUDIT_TRAIL_SIGNING_SECRET=

# ── Cloudflare Turnstile (CAPTCHA) ────────────────────────────────────────────
# Test keys below always pass — replace with real keys for production.
# Get real keys from: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ── GitHub OAuth (optional) ───────────────────────────────────────────────────
# Create at: https://github.com/settings/applications/new
# Callback URL: http://localhost:3001/auth/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
NODE_ENV="development"

# ── BILLING MODE ──────────────────────────────────────────────────────────────
BILLING_MODE=manual

# ── BREVO ─────────────────────────────────────────────────────────────────────
# Brevo transactional email. Use a SEPARATE key for local dev vs production.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@devfortress.net
BREVO_SENDER_NAME=DevFortress
# 'log' = do not send, only log (local dev). 'send' = real delivery. Production always sends.
EMAIL_DELIVERY_MODE=log
ENTERPRISE_ADMIN_EMAIL=support@devfortress.net

# ── ADMIN PROTECTION ──────────────────────────────────────────────────────────
ADMIN_SECRET=

# ── BANK WIRE DETAILS (never hardcode — always from env) ─────────────────────
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_SWIFT_CODE=
BANK_BRANCH=

# ── PADDLE — local dev uses SANDBOX credentials (get your own at
# https://sandbox-vendors.paddle.com/), no production billing risk ──────────
PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY="pdl_sdbx_apikey_your_sandbox_key_here"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_your_sandbox_client_token_here"
PADDLE_WEBHOOK_SECRET="pdl_ntfset_your_sandbox_webhook_secret_here"
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_TEAMS=
PADDLE_STARTER_ANNUAL_PRICE_ID=
PADDLE_PRO_ANNUAL_PRICE_ID=
PADDLE_TEAMS_ANNUAL_PRICE_ID=
PADDLE_BETA_DISCOUNT_ID=
PADDLE_PRICE_EXTRA_APP_PRO=
PADDLE_PRICE_EXTRA_AGENT_PRO=
PADDLE_PRICE_EXTRA_SEAT_PRO=
PADDLE_PRICE_EVENTS_OVERAGE_PRO=
PADDLE_PRICE_EVENTS_OVERAGE_TEAM=
PADDLE_PRICE_COMPLIANCE_BUNDLE_TEAMS=
PADDLE_PRICE_PRIORITY_SUPPORT_PRO=

# Production Paddle credentials — set ONLY in Vercel, never here (same
# variable names as above, so leave these commented to avoid colliding with
# the sandbox values via dotenv's last-value-wins parsing).
# PADDLE_API_KEY=
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=production

# ── GOOGLE ANALYTICS (GA4) ─────────────────────────────────────────────────────
# GA4 property "Measurement ID" (starts with "G-"). NEXT_PUBLIC_GA_MEASUREMENT_ID
# is also accepted as an alias.
NEXT_PUBLIC_GA_ID=

# ── HubCommerce companion app (local cross-project dev only) ──────────────────
# Only needed if you're also running the HubCommerce demo client locally.
HC_TEST_PASSWORD=
HC_SUPABASE_ANON_KEY=

# ── LOCAL AUTH (dev / self-host only — USE_LOCAL_AUTH=true) ───────────────────
# Signs the HttpOnly `local-auth-session` cookie (HMAC-SHA256). Dev/self-host
# only — local-auth mode is never the production auth path, so this must NOT
# be set in Vercel Production/Preview. Generate with:
#   openssl rand -hex 32
LOCAL_AUTH_SESSION_SECRET=

# Zendesk Configuration
ZENDESK_SUBDOMAIN=""

# Intercom Configuration
INTERCOM_APP_ID=""

# ============================================
# WAF & Security Services
# ============================================
# Cloudflare WAF Configuration
CLOUDFLARE_API_KEY=""
CLOUDFLARE_ZONE_ID=""

# ============================================
# Feature Flags
# ============================================
# Portal & Features
NEXT_PUBLIC_PORTAL_ENABLED="true"
NEXT_PUBLIC_DEVELOPMENT_MODE="false"

# Testing Modes
LOCAL_TESTING_MODE="false"

# ============================================
# Development & Testing Only
# ============================================
# Jest Testing
JEST_WORKER_ID="" # Automatically set by Jest

# Base URL for API testing
BASE_URL="http://localhost:3000"

# ============================================
# Email Services (Optional)
# ============================================
# Brevo Configuration (Optional for transactional emails)
BREVO_API_KEY="your_brevo_api_key"
FROM_EMAIL="no-reply@devfortress.net"
FROM_NAME="DevFortress"

# ============================================
# Paddle Payment Provider (International)
# ============================================
# Paddle acts as Merchant of Record — handles tax/VAT globally
# Sign up at https://www.paddle.com/ (sandbox for testing)
ENABLE_PADDLE="false"
PADDLE_VENDOR_ID=""
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_ENVIRONMENT="sandbox"
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
PADDLE_BETA_DISCOUNT_ID=""
PADDLE_PRICE_STARTER=""
PADDLE_PRICE_PRO=""
PADDLE_PRICE_ENTERPRISE=""

# ============================================
# Paystack Payment Provider (African Markets)
# ============================================
# For local currency payments (KES, NGN, GHS, ZAR, M-Pesa)
ENABLE_PAYSTACK="false"
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ============================================
# IMPORTANT SECURITY NOTES
# ============================================
# 1. NEVER commit this file with real secrets to version control
# 2. Copy to .env.local and fill in actual values
# 3. Keep SESSION_SECRET at minimum 32 characters
# 4. Rotate secrets regularly in production
# 5. Use environment-specific values (dev/staging/prod)
# 6. All NEXT_PUBLIC_* variables are exposed to the browser
# 7. Never put sensitive keys in NEXT_PUBLIC_* variables


# ==============================================
# DEVFORTRESS SDK SELF-MONITORING (optional)
# ==============================================
# Enable self-monitoring: the platform uses its own SDK to monitor itself
DEVFORTRESS_API_KEY=
DEVFORTRESS_ENDPOINT=https://www.devfortress.net/api/events/ingest
DEVFORTRESS_APP_ID=devfortress-platform
DEVFORTRESS_TEST_IP=127.0.0.1,::1

# ============================================
# Enterprise Identity & Access
# ============================================
SAML_ENTRY_POINT="https://idp.example.com/sso"
SAML_ISSUER="devfortress.net"
SAML_CERT="base64_encoded_certificate_here"

# ============================================
# SIEM Connectors (Enterprise)
# ============================================
SPLUNK_HEC_URL=""
SPLUNK_HEC_TOKEN=""
DATADOG_API_KEY=""
DATADOG_SITE="datadoghq.com"
SENTINEL_WORKSPACE_ID=""
SENTINEL_SHARED_KEY=""

# ============================================
# OAuth Providers
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# Licensing
# ============================================
LICENSE_SIGNING_SECRET=
