{
  "name": "devfortress/sdk-laravel",
  "description": "DevFortress adapter for Laravel (external mode).",
  "type": "library",
  "license": "BUSL-1.1",
  "keywords": [
    "security",
    "devfortress",
    "laravel",
    "middleware"
  ],
  "authors": [
    {
      "name": "Duncan Ndungu Ndegwa"
    }
  ],
  "require": {
    "php": "^8.2",
    "devfortress/sdk-php": "^0.1",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../devfortress-php",
      "options": {
        "symlink": true,
        "versions": {
          "devfortress/sdk-php": "0.1.0"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "DevFortress\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DevFortress\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DevFortress\\Laravel\\DevFortressServiceProvider"
      ],
      "aliases": {
        "DevFortress": "DevFortress\\Laravel\\Facades\\DevFortress"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
