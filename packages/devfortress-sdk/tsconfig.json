{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/consent-alias-lifecycle.ts",
    "src/multi-hop-trust-chain.ts",
    "src/idor-detector.ts",
    "src/supply-chain-validator.ts",
    "src/agent-output-exfiltration-detector.ts",
    "src/tls-cert-pinning-enforcer.ts",
    "src/enumeration-timing-shield.ts",
    "src/shadow-agent-registry.ts",
    "src/dns-hijacking-detector.ts",
    "src/predictive-attack-trajectory.ts"
  ]
}
