{
  "name": "devfortress/devfortress-sdk",
  "description": "DevFortress event reporting client for PHP (external mode).",
  "type": "library",
  "license": "BUSL-1.1",
  "keywords": [
    "security",
    "devfortress",
    "events",
    "sdk"
  ],
  "authors": [
    {
      "name": "Duncan Ndungu Ndegwa"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-hash": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "DevFortress\\Sdk\\": "src/"
    },
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "DevFortress\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": [
      "phpstan analyse --memory-limit=1G -c phpstan.neon.dist",
      "phpstan analyse --memory-limit=1G -c phpstan.tests.neon.dist"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
